<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Description>Win32 implementations: low-level keyboard hook, microphone capture, text injection.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- For the UI Automation client assemblies, which ship with the Windows Desktop framework
         reference. This project draws no UI; it only needs UIAutomationClient/UIAutomationTypes. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- DPAPI (ProtectedData) is not in the net8.0 BCL; it ships as this package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TawkType.Core\TawkType.Core.csproj" />
  </ItemGroup>

</Project>
