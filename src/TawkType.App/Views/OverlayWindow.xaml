<Window x:Class="TawkType.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TawkType.Desktop.ViewModels"
        xmlns:views="clr-namespace:TawkType.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="TawkType status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Brand.Font}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />

        <!-- Toolbar glyphs: 22px hit target, muted until hovered. Deliberately quiet — the bar is on
             screen all day and these must not compete with the dictation state. -->
        <Style x:Key="BarButton" TargetType="Button">
            <!-- The glyph takes the button's Foreground, so a derived style can light one up without
                 restating the whole template. -->
            <Setter Property="Foreground" Value="#8A90A8" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5">
                            <Path x:Name="Glyph" Data="{TemplateBinding Tag}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="#F5F6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The dictation box button, which is on the bar at all times. Lit when a dictation is
             actually waiting in there, so "there is something for you" is visible at a glance rather
             than only in a tooltip. -->
        <Style x:Key="BarButtonAlert" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecoverable}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Overlay.Text}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Outer border is the 1.5px ring; it takes the brand gradient while listening.
         The 18px margin is the drop shadow's room, and is what makes the window bigger than the bar. -->
    <Border Margin="18" CornerRadius="18" Padding="1.5" Opacity="{Binding Opacity}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Overlay.Border}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateKey}" Value="Listening">
                        <Setter Property="Background" Value="{StaticResource Brand.VoiceGradient}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="#0E0F16" />
        </Border.Effect>

        <Border CornerRadius="17" Background="{StaticResource Overlay.Surface}">
            <Grid>

                <!-- ===================== Full bar ===================== -->
                <Grid Width="394" Height="78">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar. Left: the things you might want mid-session. Right: window controls. -->
                    <DockPanel Grid.Row="0" Margin="8,5,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- The one setting that changes between one dictation and the next, so the
                                 one worth a permanent place here. A mode you cannot see is a mode you
                                 will be surprised by. -->
                            <!-- Feature research §9: where the next dictation goes, on screen while
                                 you are using it. One word, because that is the room there is; the
                                 whole state is in the tooltip. It says Local while the rewrite is
                                 switched on but cannot run, because that is what will happen. -->
                            <Border CornerRadius="7" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                    ToolTipService.ShowDuration="30000" ToolTip="{Binding PrivacyTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1F2636" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrivacyIsCloud}" Value="True">
                                                <Setter Property="Background" Value="#3A2F5E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PrivacyBadge}" FontSize="9.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Overlay.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrivacyIsCloud}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brand.AccentTint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding ModeName}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontSize="10.5"
                                       Foreground="{StaticResource Overlay.TextMuted}" />
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Minimize}"
                                    Command="{Binding HideCommand}"
                                    ToolTip="Hide the bar. Click the TawkType tray icon to bring it back." />
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Close}"
                                    Command="{Binding QuitCommand}"
                                    ToolTip="Quit TawkType. To keep it running but off screen, use the button to the left." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Gear}"
                                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings" />
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Clock}"
                                    Command="{Binding OpenHistoryCommand}" ToolTip="History" />
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Clipboard}"
                                    Command="{Binding CopyLastCommand}" ToolTip="Copy the last dictation" />
                            <!-- Always here. It used to appear only after a delivery failed, on the
                                 reasoning that the bar should not carry a button that does nothing —
                                 but the box is also a scratchpad to dictate into deliberately, so it
                                 was never doing nothing, and hiding it left no obvious way in at all. -->
                            <Button Style="{StaticResource BarButtonAlert}" Tag="{x:Static views:Icons.Rescue}"
                                    Command="{Binding OpenDictationBoxCommand}"
                                    ToolTip="{Binding DictationBoxTooltip}" />

                            <!-- Same rule as the recovery button: on the bar only while it means
                                 something. An update that has downloaded and is waiting for a restart
                                 has no other way of telling anyone. -->
                            <Button Style="{StaticResource BarButton}" Tag="{x:Static views:Icons.Update}"
                                    Command="{Binding ApplyUpdateCommand}"
                                    ToolTip="{Binding UpdateTooltip}"
                                    Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisible}}" />

                            <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="11" Foreground="{StaticResource State.Injecting}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Idle / working: the mark and what to do, centred. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsListening, Converter={StaticResource NotBoolToVis}}">
                        <!-- The app icon, not a hand-coloured copy of the mark.
                             It was drawn in XAML so its bars could take the state colour, but the ring
                             around the bar, the status text and the waveform all say the state too -
                             this was the third copy of that signal and the one that kept looking wrong.
                             Using the icon means the bar carries the same thing as the taskbar, the
                             tray and the Start menu, and there is nothing left to tint. -->
                        <!-- Just the bubble, tinted. The full mark carries a voice and an I-beam
                             inside it, and at this size that interior detail turns to mush; the app
                             icon's gradient chip did not survive the downscale either. The silhouette
                             alone reads as a speech bubble instantly, and tinting the whole shape is
                             far more legible than tinting three bars two pixels wide. -->
                        <Viewbox Width="21" Height="21" Margin="0,0,11,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource Brand.BubbleGeometry}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#8A90A8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateKey}" Value="Transcribing">
                                                <Setter Property="Fill" Value="{StaticResource State.Transcribing}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKey}" Value="Polishing">
                                                <Setter Property="Fill" Value="{StaticResource State.Transcribing}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKey}" Value="Injecting">
                                                <Setter Property="Fill" Value="{StaticResource State.Injecting}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKey}" Value="Error">
                                                <Setter Property="Fill" Value="{StaticResource State.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StateLabel}"
                                   MaxWidth="250" TextTrimming="CharacterEllipsis" />

                        <ProgressBar Width="110" Height="5" Margin="14,0,0,0"
                                     Minimum="0" Maximum="1" BorderThickness="0"
                                     Background="#22FFFFFF" Foreground="{StaticResource Brand.Accent}"
                                     Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Listening: label left, live waveform centre, elapsed right. -->
                    <Grid Grid.Row="1" Margin="18,0,18,10"
                          Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StateLabel}"
                                   HorizontalAlignment="Left" />

                        <ItemsControl ItemsSource="{Binding Bars}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5"
                                               VerticalAlignment="Center"
                                               Height="{Binding Height}"
                                               Fill="{StaticResource Brand.VoiceGradient}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ElapsedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource State.Listening}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
