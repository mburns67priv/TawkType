<Window x:Class="TawkType.Desktop.Views.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippet"
        Icon="pack://application:,,,/Assets/tawktype.ico"
        Width="520" Height="470"
        MinWidth="420" MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Heading" FontFamily="{StaticResource Brand.DisplayFont}"
                       FontSize="16" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ui.TextMuted}" FontSize="11.5"
                       Margin="0,0,0,14"
                       Text="Saved text, typed exactly as written. Snippets skip the Claude pass, so a signature or a template comes out the way you wrote it." />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Trigger" Style="{StaticResource Ui.Label}" />
            <TextBox x:Name="TriggerBox" Style="{StaticResource Ui.TextBox}"
                     TextChanged="OnTriggerChanged" PreviewKeyDown="OnTriggerKeyDown" />
        </StackPanel>

        <!-- The most useful line on the page: the word "insert" is what makes a snippet fire, and
             nothing anywhere else says so until you have already got it wrong. -->
        <TextBlock x:Name="SayPreview" Grid.Row="2" Style="{StaticResource Ui.Hint}" TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="Text to type" Style="{StaticResource Ui.Label}" />
            <TextBox x:Name="TextBoxField" Style="{StaticResource Ui.MultilineTextBox}"
                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="120" />
        </DockPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Style="{StaticResource Ui.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Press Enter for a line break. Whatever you type here is typed exactly, line breaks and all. Ctrl+Enter saves." />
            <TextBlock x:Name="Problem" Style="{StaticResource Ui.FieldError}" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource Ui.Button}" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancelClick" />
            <!-- Deliberately NOT IsDefault: Enter belongs to the text area. A snippet dialog with a
                 default button eats the user's line breaks. Ctrl+Enter saves instead. -->
            <Button x:Name="PrimaryButton" Style="{StaticResource Ui.PrimaryButton}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
