<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TawkType.Desktop</RootNamespace>
    <AssemblyName>TawkType</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tawktype.ico</ApplicationIcon>

    <!-- What Windows shows in the file properties, the installer and Task Manager. -->
    <Product>TawkType</Product>
    <AssemblyTitle>TawkType</AssemblyTitle>
    <Company>Jupitor Studio</Company>
    <Description>TawkType: local voice typing for Windows. Hold a key, speak, release.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/TawkType.Brand; used for the exe, windows, and the tray. -->
    <Resource Include="Assets\tawktype.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 2.4.x dropped net8.0; 2.3.2 is the last release with a net8.0-windows build. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TawkType.Core\TawkType.Core.csproj" />
    <ProjectReference Include="..\TawkType.Windows\TawkType.Windows.csproj" />
    <ProjectReference Include="..\TawkType.Transcription\TawkType.Transcription.csproj" />
    <ProjectReference Include="..\TawkType.Llm\TawkType.Llm.csproj" />
  </ItemGroup>

  <!-- Whisper.net.Runtime.Vulkan ships its linux-x64 binaries even in a Windows-only build (its targets
       have a single item group covering both), and a win-x64 publish has no use for the other Windows
       architectures either. Together that is around 60 MB of an installer nobody can use, so strip it
       after publish rather than depending on each package to get its conditions right. -->
  <Target Name="TrimForeignNatives" AfterTargets="Publish">
    <ItemGroup>
      <ForeignNative Include="$(PublishDir)**\*.so" />
      <ForeignNative Include="$(PublishDir)**\*.dylib" />
      <ForeignNative Include="$(PublishDir)**\*.a" />
      <ForeignNative Include="$(PublishDir)**\*.metal" />
      <ForeignNative Include="$(PublishDir)runtimes\**\linux-*\**\*" />
      <ForeignNative Include="$(PublishDir)runtimes\**\osx*\**\*" />
      <ForeignNative Include="$(PublishDir)runtimes\**\macos*\**\*" />
      <ForeignNative Include="$(PublishDir)runtimes\win-arm64\**\*" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <ForeignNative Include="$(PublishDir)runtimes\win-x86\**\*" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    </ItemGroup>
    <Delete Files="@(ForeignNative)" ContinueOnError="true" />
    <RemoveDir Directories="@(ForeignNative->'%(RootDir)%(Directory)')" ContinueOnError="true" />
  </Target>

</Project>
