<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Murmur.Desktop</RootNamespace>
    <AssemblyName>Murmur</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Murmur desktop app: tray icon, overlay, settings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 2.4.x dropped net8.0; 2.3.2 is the last release with a net8.0-windows build. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\Murmur.Windows\Murmur.Windows.csproj" />
    <ProjectReference Include="..\Murmur.Transcription\Murmur.Transcription.csproj" />
  </ItemGroup>

</Project>
