<Application x:Class="Murmur.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Brand tokens. Placeholder palette until the real identity lands; every view reads from here. -->
        <Color x:Key="Brand.AccentColor">#7C5CFF</Color>
        <SolidColorBrush x:Key="Brand.Accent" Color="{StaticResource Brand.AccentColor}" />
        <SolidColorBrush x:Key="Brand.Surface" Color="#F214151E" />
        <SolidColorBrush x:Key="Brand.SurfaceRaised" Color="#FF1E1F2B" />
        <SolidColorBrush x:Key="Brand.SurfaceBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Brand.Text" Color="#F4F4F8" />
        <SolidColorBrush x:Key="Brand.TextMuted" Color="#9A9BB0" />
        <SolidColorBrush x:Key="State.Listening" Color="#FF5C7A" />
        <SolidColorBrush x:Key="State.Transcribing" Color="#7C5CFF" />
        <SolidColorBrush x:Key="State.Injecting" Color="#3DDC97" />
        <SolidColorBrush x:Key="State.Error" Color="#FFB020" />
        <FontFamily x:Key="Brand.Font">Segoe UI Variable Text, Segoe UI</FontFamily>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Murmur — hold Right Ctrl to dictate"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{x:Null}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="M"
                                        Foreground="White"
                                        Background="{StaticResource Brand.Accent}"
                                        FontSize="42"
                                        FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings…" Click="OnSettingsClick" />
                    <MenuItem Header="Test dictation (records 3 s)" Click="OnTestDictationClick" />
                    <MenuItem Header="Open data folder" Click="OnOpenDataFolderClick" />
                    <MenuItem Header="Delete downloaded models…" Click="OnDeleteModelsClick" />
                    <Separator />
                    <MenuItem Header="Quit Murmur" Click="OnQuitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
