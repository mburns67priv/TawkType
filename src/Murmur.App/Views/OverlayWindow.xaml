<Window x:Class="Murmur.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Murmur.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="Murmur"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Brand.Font}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="Pill"
            Margin="24"
            Padding="18,11"
            CornerRadius="24"
            Background="{StaticResource Brand.Surface}"
            BorderBrush="{StaticResource Brand.SurfaceBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Status dot, coloured by state -->
            <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource State.Transcribing}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKey}" Value="Listening">
                                <Setter Property="Fill" Value="{StaticResource State.Listening}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Injecting">
                                <Setter Property="Fill" Value="{StaticResource State.Injecting}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Error">
                                <Setter Property="Fill" Value="{StaticResource State.Error}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource Brand.Text}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <!-- Mic level meter, only while listening -->
            <Border Width="72" Height="6"
                    Margin="14,0,0,0"
                    CornerRadius="3"
                    Background="#22FFFFFF"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}">
                <Rectangle HorizontalAlignment="Left"
                           RadiusX="3" RadiusY="3"
                           Fill="{StaticResource State.Listening}"
                           Width="{Binding LevelWidth}" />
            </Border>

            <!-- Model download / load progress -->
            <ProgressBar Width="120" Height="6"
                         Margin="14,0,0,0"
                         Minimum="0" Maximum="1"
                         BorderThickness="0"
                         Background="#22FFFFFF"
                         Foreground="{StaticResource Brand.Accent}"
                         Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         VerticalAlignment="Center"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
