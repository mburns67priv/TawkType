<Window x:Class="Murmur.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Murmur.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Murmur Settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brand.SurfaceRaised}"
        Foreground="{StaticResource Brand.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <!-- Keyed (not implicit) so it never leaks into the TextBlocks that ComboBox generates for its items. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-6,0,12" />
        </Style>
        <SolidColorBrush x:Key="InputText" Color="#1B1C28" />
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition /> <!-- 0 heading -->
            <RowDefinition /> <!-- 1 hotkey -->
            <RowDefinition /> <!-- 2 hotkey hint -->
            <RowDefinition /> <!-- 3 suppress -->
            <RowDefinition /> <!-- 4 microphone -->
            <RowDefinition /> <!-- 5 language -->
            <RowDefinition /> <!-- 6 engine -->
            <RowDefinition /> <!-- 7 engine hint -->
            <RowDefinition /> <!-- 8 whisper model -->
            <RowDefinition /> <!-- 9 model hint -->
            <RowDefinition /> <!-- 10 min hold -->
            <RowDefinition /> <!-- 11 injection -->
            <RowDefinition /> <!-- 12 fillers -->
            <RowDefinition /> <!-- 13 trailing space -->
            <RowDefinition /> <!-- 14 storage -->
            <RowDefinition /> <!-- 15 path -->
            <RowDefinition /> <!-- 16 buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Label}" Text="Murmur" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Push-to-talk key" />
        <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                  ItemsSource="{Binding Hotkeys}"
                  Text="{Binding Draft.Hotkey, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Hold to talk, release to type. Pick a name from the list, or a hex code like 0xA3." />

        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Draft.SuppressHotkey}">
            <TextBlock Text="Hide the key from other apps (not applied to modifier keys)" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Microphone" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  ItemsSource="{Binding InputDevices}"
                  SelectedItem="{Binding SelectedInputDevice}" />

        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Language" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Draft.Language, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Engine" />
        <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding Engines}"
                  SelectedItem="{Binding Draft.Engine}" />
        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Auto uses Parakeet (fast, most accurate for English and 24 other European languages, 670 MB) and falls back to Whisper for everything else." />

        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Whisper model" />
        <ComboBox Grid.Row="8" Grid.Column="1"
                  ItemsSource="{Binding Models}"
                  SelectedItem="{Binding Draft.Model}" />
        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Only used when the Whisper engine is active. LargeV3Turbo is the best fit for an RTX 4060 Ti (1.6 GB download)." />

        <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Ignore taps under (ms)" />
        <TextBox Grid.Row="10" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                 Text="{Binding MinimumHoldText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Insert text by" />
        <ComboBox Grid.Row="11" Grid.Column="1"
                  ItemsSource="{Binding InjectionModes}"
                  SelectedItem="{Binding Draft.InjectionMode}" />

        <CheckBox Grid.Row="12" Grid.Column="1" Content="Remove filler words (um, uh, erm…)"
                  IsChecked="{Binding Draft.RemoveFillerWords}" />
        <CheckBox Grid.Row="13" Grid.Column="1" Content="Add a trailing space after each dictation"
                  IsChecked="{Binding Draft.AppendTrailingSpace}" />

        <TextBlock Grid.Row="14" Style="{StaticResource Label}" Text="Downloaded models" VerticalAlignment="Top" Margin="0,4,12,10" />
        <StackPanel Grid.Row="14" Grid.Column="1" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="{Binding ModelStorageText}" />
            <Button Content="Delete downloaded models…" HorizontalAlignment="Left" Margin="0"
                    Command="{Binding DeleteModelsCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

        <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,8,0,14"
                   Text="{Binding SettingsPath, StringFormat='Saved to {0}'}" />

        <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
