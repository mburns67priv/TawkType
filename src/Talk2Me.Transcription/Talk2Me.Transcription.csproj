<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Local speech-to-text via Whisper.net (whisper.cpp) with GPU runtimes and model management.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Runtime order is configured in WhisperTranscriber: CUDA 12 -> Vulkan -> CPU.
         CUDA needs the NVIDIA CUDA Toolkit >= 12.4 installed; Vulkan works with the stock NVIDIA driver. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda12" Version="1.9.1" />
    <!-- NVIDIA Parakeet TDT 0.6B v3 via sherpa-onnx (ONNX Runtime, CPU int8). Native win-x64 DLLs are bundled. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Talk2Me.Core\Talk2Me.Core.csproj" />
  </ItemGroup>

</Project>
