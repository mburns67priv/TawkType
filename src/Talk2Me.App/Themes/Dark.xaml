<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every key here must also exist in Light.xaml. The two are swapped wholesale at runtime. -->
    <!-- Tokens from docs/tawktype-brand/BRAND-PACKAGE.md. -->

    <SolidColorBrush x:Key="Ui.Window" Color="#11131D" />
    <SolidColorBrush x:Key="Ui.Sidebar" Color="#0D0F17" />
    <SolidColorBrush x:Key="Ui.Card" Color="#1C2030" />
    <SolidColorBrush x:Key="Ui.CardHover" Color="#242942" />
    <SolidColorBrush x:Key="Ui.Input" Color="#0D0F17" />
    <SolidColorBrush x:Key="Ui.Border" Color="#363C50" />

    <SolidColorBrush x:Key="Ui.Text" Color="#F5F6FA" />
    <SolidColorBrush x:Key="Ui.TextMuted" Color="#B5BDCF" />

    <!-- Dark text on bright violet: the brand package asks for this pairing explicitly, and white on
         #7867FF does not carry enough contrast to be the default. -->
    <SolidColorBrush x:Key="Ui.TextOnAccent" Color="#171925" />

    <SolidColorBrush x:Key="Ui.NavSelected" Color="#2A2755" />
    <SolidColorBrush x:Key="Ui.NavHover" Color="#1C2030" />

    <!-- The violet tint, not the tile violet: #7867FF is the icon's colour and is too strong for text. -->
    <SolidColorBrush x:Key="Ui.Accent" Color="#B4A9FF" />
    <SolidColorBrush x:Key="Ui.AccentSoft" Color="#272451" />
    <SolidColorBrush x:Key="Ui.Danger" Color="#FF8A9E" />

</ResourceDictionary>
