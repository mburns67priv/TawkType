<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every key here must also exist in Dark.xaml. The two are swapped wholesale at runtime. -->

    <!-- Window ground, then the raised cards and inputs that sit on it. -->
    <SolidColorBrush x:Key="Ui.Window" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ui.Sidebar" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Ui.Card" Color="#F2F4F7" />
    <SolidColorBrush x:Key="Ui.CardHover" Color="#E8EBF0" />
    <SolidColorBrush x:Key="Ui.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ui.Border" Color="#DFE3EA" />

    <SolidColorBrush x:Key="Ui.Text" Color="#1B1C28" />
    <SolidColorBrush x:Key="Ui.TextMuted" Color="#6B7182" />
    <SolidColorBrush x:Key="Ui.TextOnAccent" Color="#FFFFFF" />

    <!-- Nav rail: selected row and its hover state. -->
    <SolidColorBrush x:Key="Ui.NavSelected" Color="#E9E7FF" />
    <SolidColorBrush x:Key="Ui.NavHover" Color="#EFF1F5" />

    <!-- The violet reads well on white at full strength. -->
    <SolidColorBrush x:Key="Ui.Accent" Color="#5A49F0" />
    <SolidColorBrush x:Key="Ui.AccentSoft" Color="#EDEBFF" />
    <SolidColorBrush x:Key="Ui.Danger" Color="#C4324B" />

</ResourceDictionary>
