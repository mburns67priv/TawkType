<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Talk2Me.Desktop</RootNamespace>
    <AssemblyName>Talk2Me</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\talk2me.ico</ApplicationIcon>
    <Description>Talk2Me desktop app: tray icon, overlay, settings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/Talk2Me.Brand; used for the exe, windows, and the tray. -->
    <Resource Include="Assets\talk2me.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 2.4.x dropped net8.0; 2.3.2 is the last release with a net8.0-windows build. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Talk2Me.Core\Talk2Me.Core.csproj" />
    <ProjectReference Include="..\Talk2Me.Windows\Talk2Me.Windows.csproj" />
    <ProjectReference Include="..\Talk2Me.Transcription\Talk2Me.Transcription.csproj" />
    <ProjectReference Include="..\Talk2Me.Llm\Talk2Me.Llm.csproj" />
  </ItemGroup>

</Project>
