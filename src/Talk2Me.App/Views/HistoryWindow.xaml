<Window x:Class="Talk2Me.Desktop.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Talk2Me.Desktop.ViewModels"
        xmlns:views="clr-namespace:Talk2Me.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="Talk2Me History"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="420"
        Height="520"
        MinWidth="320"
        MinHeight="320"
        Background="{StaticResource Brand.SurfaceRaised}"
        Foreground="{StaticResource Brand.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="InputText" Color="#1B1C28" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 header + copy last -->
            <RowDefinition Height="*" />    <!-- 1 list -->
            <RowDefinition Height="Auto" /> <!-- 2 selected entry -->
            <RowDefinition Height="Auto" /> <!-- 3 footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Brand.VoiceGradient}" Margin="0,0,9,0">
                    <views:BrandMark Width="19" Height="19" Margin="0,1,0,0" />
                </Border>
                <TextBlock Text="History" FontFamily="{StaticResource Brand.DisplayFont}" FontSize="17"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource Brand.Text}" />
            </StackPanel>

            <!-- The whole point of the window: get back the dictation that went nowhere. -->
            <Button Content="Copy last dictation" HorizontalAlignment="Stretch" Margin="0" Padding="12,9"
                    FontWeight="SemiBold" Command="{Binding CopyLastCommand}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="6"
                BorderBrush="{StaticResource Brand.SurfaceBorder}">
            <Grid>
                <TextBlock Text="Nothing dictated yet. Hold your push-to-talk key and speak."
                           Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="18"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4,2,6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding DayText}" Style="{StaticResource Meta}" />
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Meta}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding FinalText}" TextWrapping="Wrap" MaxHeight="58"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brand.Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- The selected row in full: what was heard, what was typed, and a copy button for it. -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Selected.MetaText}" Style="{StaticResource Meta}" Margin="0,0,0,6" />

            <TextBlock Text="Heard" Style="{StaticResource Meta}" Margin="0,0,0,2"
                       Visibility="{Binding Selected.ShowRaw, Converter={StaticResource BoolToVisible}}" />
            <TextBox Text="{Binding Selected.RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                     Visibility="{Binding Selected.ShowRaw, Converter={StaticResource BoolToVisible}}" />

            <TextBlock Text="Typed" Style="{StaticResource Meta}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Selected.FinalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

            <Button Content="Copy this one" HorizontalAlignment="Left"
                    Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" Margin="0,0,0,6"
                       TextWrapping="Wrap" Foreground="{StaticResource Brand.Coral}" />
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}"
                          VerticalAlignment="Center" Margin="0,0,14,0"
                          Foreground="{StaticResource Brand.Text}" />
                <Button Content="Clear…" Command="{Binding ClearCommand}" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
