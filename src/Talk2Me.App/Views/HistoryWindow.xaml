<Window x:Class="Talk2Me.Desktop.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Talk2Me.Desktop.ViewModels"
        xmlns:views="clr-namespace:Talk2Me.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="TawkType History"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="420"
        Height="560"
        MinWidth="340"
        MinHeight="320"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <!-- The compact button the expanded row is full of: same chrome as Ui.Button, smaller. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Ui.Button}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <!-- Three fixed bands and one scrolling list. There is deliberately no second scroll region: a
         selected row expands in place, so the list never has to share its height with a detail pane. -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 title + copy last -->
            <RowDefinition Height="Auto" /> <!-- 1 search -->
            <RowDefinition Height="*" />    <!-- 2 the list -->
            <RowDefinition Height="Auto" /> <!-- 3 footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="26" Height="26" CornerRadius="6"
                        Background="{StaticResource Brand.VoiceGradient}" Margin="0,0,10,0">
                    <!-- White bubble, violet bars, exactly as the app icon is drawn. Both white makes the
                                 bars vanish into the bubble and the mark stops being the mark. -->
                            <views:BrandMark Width="19" Height="19" Margin="0,1,0,0"
                                             BarsBrush="{StaticResource Brand.Accent}" />
                </Border>
                <TextBlock Text="History" FontFamily="{StaticResource Brand.DisplayFont}" FontSize="17"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ui.Text}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Ui.Accent}" />
            </StackPanel>

            <!-- The whole point of the window: get back the dictation that went nowhere. -->
            <Button Content="Copy last dictation" Style="{StaticResource Ui.PrimaryButton}"
                    HorizontalAlignment="Stretch" Padding="12,10"
                    Command="{Binding CopyLastCommand}" />
        </StackPanel>

        <!-- The hint sits behind the box rather than above it: a 560px window has no row to spare, and
             the box is obviously a box without a label on top of it. -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox Style="{StaticResource Ui.TextBox}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <TextBlock Text="Search what you have said" IsHitTestVisible="False"
                       Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding IsFiltered, Converter={StaticResource InverseBoolToVisible}}" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="{StaticResource Ui.CornerRadius}"
                Background="{DynamicResource Ui.Card}">
            <Grid>
                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="24"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0" Margin="0,4"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource Ui.HistoryItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Header: when it happened, how it was produced, and — once expanded —
                                     Copy. Copy lives up here so a long dictation cannot push it out of view. -->
                                <DockPanel Margin="0,0,0,4">
                                    <StackPanel x:Name="RowActions" DockPanel.Dock="Right"
                                                Orientation="Horizontal" Visibility="Collapsed"
                                                VerticalAlignment="Top" Margin="8,-2,0,0">
                                        <Button Content="Copy" Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete" Style="{StaticResource RowButton}"
                                                Foreground="{DynamicResource Ui.Danger}"
                                                ToolTip="Remove this dictation from the log and the file"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DayText}" Style="{StaticResource Meta}" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Meta}" Margin="6,0,0,0" />
                                        <!-- Trimmed rather than clipped: the row header shares its width
                                             with Copy and Delete, and a chopped glyph reads as a bug. -->
                                        <TextBlock x:Name="Engine" Text="{Binding MetaText}" Style="{StaticResource Meta}"
                                                   Margin="10,0,0,0" Visibility="Collapsed"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Collapsed: two lines of the typed text, trimmed. -->
                                <TextBlock x:Name="Preview" Text="{Binding FinalText}"
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />

                                <!-- Expanded: the whole thing, selectable, plus what was heard if it differs. -->
                                <StackPanel x:Name="Full" Visibility="Collapsed">
                                    <!-- Editable. Nothing is written until Save, so reading through the
                                         log cannot change it by accident. -->
                                    <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Ui.MultilineTextBox}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisible}}">
                                        <Button Content="Save" Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Revert" Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.RevertEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <StackPanel x:Name="Raw" Margin="0,10,0,2"
                                                Visibility="{Binding ShowRaw, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="Heard" Style="{StaticResource Meta}" Margin="0,0,0,3" />
                                        <TextBox x:Name="HeardBox" Text="{Binding RawText, Mode=OneWay}"
                                                 Style="{StaticResource Ui.ReadOnlyText}"
                                                 Foreground="{DynamicResource Ui.TextMuted}" />
                                    </StackPanel>

                                    <!-- The two things worth doing with a dictation that came out wrong:
                                         run cleanup over it again, or teach TawkType the correction. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Copy heard" Style="{StaticResource RowButton}"
                                                Visibility="{Binding ShowRaw, Converter={StaticResource BoolToVisible}}"
                                                Command="{Binding DataContext.CopyHeardCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Clean again" Style="{StaticResource RowButton}"
                                                ToolTip="Run cleanup over what was heard, using the settings as they are now"
                                                Command="{Binding DataContext.CleanAgainCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remember…" Style="{StaticResource RowButton}"
                                                Tag="{Binding}"
                                                ToolTip="Save a correction so this comes out right next time"
                                                Click="OnRememberClick" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Value="True"
                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <Setter TargetName="Preview" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Full" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Engine" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox Content="Always on top" Style="{StaticResource Ui.CheckBox}"
                      IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="4,0,0,0" />
            <Button Content="Clear…" Style="{StaticResource Ui.DangerButton}"
                    HorizontalAlignment="Right" Margin="14,0,0,0"
                    Command="{Binding ClearCommand}" />
        </StackPanel>
    </Grid>
</Window>
