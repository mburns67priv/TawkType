<Window x:Class="Talk2Me.Desktop.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Talk2Me.Desktop.ViewModels"
        xmlns:views="clr-namespace:Talk2Me.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="Talk2Me History"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="420"
        Height="560"
        MinWidth="340"
        MinHeight="320"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <!-- Three fixed bands and one scrolling list. There is deliberately no second scroll region: a
         selected row expands in place, so the list never has to share its height with a detail pane. -->
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 title + copy last -->
            <RowDefinition Height="*" />    <!-- 1 the list -->
            <RowDefinition Height="Auto" /> <!-- 2 footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="26" Height="26" CornerRadius="6"
                        Background="{StaticResource Brand.VoiceGradient}" Margin="0,0,10,0">
                    <views:BrandMark Width="19" Height="19" Margin="0,1,0,0" BarsBrush="White" />
                </Border>
                <TextBlock Text="History" FontFamily="{StaticResource Brand.DisplayFont}" FontSize="17"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ui.Text}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Ui.Accent}" />
            </StackPanel>

            <!-- The whole point of the window: get back the dictation that went nowhere. -->
            <Button Content="Copy last dictation" Style="{StaticResource Ui.PrimaryButton}"
                    HorizontalAlignment="Stretch" Padding="12,10"
                    Command="{Binding CopyLastCommand}" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="{StaticResource Ui.CornerRadius}"
                Background="{DynamicResource Ui.Card}">
            <Grid>
                <TextBlock Text="Nothing dictated yet. Hold your push-to-talk key and speak."
                           Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="24"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0" Margin="0,4"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource Ui.HistoryItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Header: when it happened, how it was produced, and — once expanded —
                                     Copy. Copy lives up here so a long dictation cannot push it out of view. -->
                                <DockPanel Margin="0,0,0,4">
                                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy"
                                            Style="{StaticResource Ui.Button}" Visibility="Collapsed"
                                            MinWidth="0" Padding="10,3" FontSize="11.5"
                                            VerticalAlignment="Top" Margin="8,-2,0,0"
                                            Command="{Binding DataContext.CopyCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DayText}" Style="{StaticResource Meta}" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Meta}" Margin="6,0,0,0" />
                                        <TextBlock x:Name="Engine" Text="{Binding MetaText}" Style="{StaticResource Meta}"
                                                   Margin="10,0,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Collapsed: two lines of the typed text, trimmed. -->
                                <TextBlock x:Name="Preview" Text="{Binding FinalText}"
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />

                                <!-- Expanded: the whole thing, selectable, plus what was heard if it differs. -->
                                <StackPanel x:Name="Full" Visibility="Collapsed">
                                    <TextBox Text="{Binding FinalText, Mode=OneWay}"
                                             Style="{StaticResource Ui.ReadOnlyText}" />

                                    <StackPanel x:Name="Raw" Margin="0,10,0,2"
                                                Visibility="{Binding ShowRaw, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="Heard" Style="{StaticResource Meta}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding RawText, Mode=OneWay}"
                                                 Style="{StaticResource Ui.ReadOnlyText}"
                                                 Foreground="{DynamicResource Ui.TextMuted}" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Value="True"
                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <Setter TargetName="Preview" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Full" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Engine" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="CopyButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox Content="Always on top" Style="{StaticResource Ui.CheckBox}"
                      IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="4,0,0,0" />
            <Button Content="Clear…" Style="{StaticResource Ui.DangerButton}"
                    HorizontalAlignment="Right" Margin="14,0,0,0"
                    Command="{Binding ClearCommand}" />
        </StackPanel>
    </Grid>
</Window>
