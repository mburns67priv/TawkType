<Window x:Class="Talk2Me.Desktop.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Talk2Me.Desktop.ViewModels"
        xmlns:views="clr-namespace:Talk2Me.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="Talk2Me History"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="420"
        Height="560"
        MinWidth="340"
        MinHeight="340"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource Ui.MultilineTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
            <Setter Property="MaxHeight" Value="58" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 header + copy last -->
            <RowDefinition Height="*" />    <!-- 1 list -->
            <RowDefinition Height="Auto" /> <!-- 2 selected entry -->
            <RowDefinition Height="Auto" /> <!-- 3 footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="26" Height="26" CornerRadius="6"
                        Background="{StaticResource Brand.VoiceGradient}" Margin="0,0,10,0">
                    <views:BrandMark Width="19" Height="19" Margin="0,1,0,0" BarsBrush="White" />
                </Border>
                <TextBlock Text="History" FontFamily="{StaticResource Brand.DisplayFont}" FontSize="17"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ui.Text}" />
            </StackPanel>

            <!-- The whole point of the window: get back the dictation that went nowhere. -->
            <Button Content="Copy last dictation" Style="{StaticResource Ui.PrimaryButton}"
                    HorizontalAlignment="Stretch" Padding="12,10"
                    Command="{Binding CopyLastCommand}" />
        </StackPanel>

        <Border Grid.Row="1" MinHeight="120" CornerRadius="{StaticResource Ui.CornerRadius}"
                Background="{DynamicResource Ui.Card}">
            <Grid>
                <TextBlock Text="Nothing dictated yet. Hold your push-to-talk key and speak."
                           Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="18"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0" Margin="4"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource Ui.NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding DayText}" Style="{StaticResource Meta}" />
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Meta}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding FinalText}" TextWrapping="Wrap" MaxHeight="58"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- The selected row in full: what was heard, what was typed, and a copy button for it.
             Height-capped, or a long dictation squeezes the list above it down to nothing. -->
        <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                      Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.MetaText}" Style="{StaticResource Meta}" Margin="0,0,0,8" />

                <TextBlock Text="Heard" Style="{StaticResource Meta}" Margin="0,0,0,3"
                           Visibility="{Binding Selected.ShowRaw, Converter={StaticResource BoolToVisible}}" />
                <TextBox Text="{Binding Selected.RawText, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                         Visibility="{Binding Selected.ShowRaw, Converter={StaticResource BoolToVisible}}" />

                <TextBlock Text="Typed" Style="{StaticResource Meta}" Margin="0,0,0,3" />
                <TextBox Text="{Binding Selected.FinalText, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />

                <Button Content="Copy this one" Style="{StaticResource Ui.Button}" HorizontalAlignment="Left"
                        Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" Margin="0,0,0,8"
                       TextWrapping="Wrap" Foreground="{DynamicResource Ui.Accent}" />
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Always on top" Style="{StaticResource Ui.CheckBox}"
                          IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Clear…" Style="{StaticResource Ui.DangerButton}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
