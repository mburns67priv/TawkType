<Window x:Class="Talk2Me.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Talk2Me.Desktop.ViewModels"
        xmlns:views="clr-namespace:Talk2Me.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Talk2Me Settings"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brand.SurfaceRaised}"
        Foreground="{StaticResource Brand.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <Window.Resources>
        <!-- Keyed (not implicit) so it never leaks into the TextBlocks that ComboBox generates for its items. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-6,0,12" />
        </Style>
        <SolidColorBrush x:Key="InputText" Color="#1B1C28" />
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition /> <!-- 0 heading -->
            <RowDefinition /> <!-- 1 hotkey -->
            <RowDefinition /> <!-- 2 hotkey hint -->
            <RowDefinition /> <!-- 3 suppress -->
            <RowDefinition /> <!-- 4 microphone -->
            <RowDefinition /> <!-- 5 language -->
            <RowDefinition /> <!-- 6 engine -->
            <RowDefinition /> <!-- 7 engine hint -->
            <RowDefinition /> <!-- 8 whisper model -->
            <RowDefinition /> <!-- 9 model hint -->
            <RowDefinition /> <!-- 10 min hold -->
            <RowDefinition /> <!-- 11 injection -->
            <RowDefinition /> <!-- 12 fillers -->
            <RowDefinition /> <!-- 13 trailing space -->
            <RowDefinition /> <!-- 14 overlay always visible -->
            <RowDefinition /> <!-- 15 overlay position -->
            <RowDefinition /> <!-- 16 cleanup -->
            <RowDefinition /> <!-- 17 history -->
            <RowDefinition /> <!-- 18 storage -->
            <RowDefinition /> <!-- 19 path -->
            <RowDefinition /> <!-- 20 buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Brand.VoiceGradient}" Margin="0,0,12,0">
                <views:BrandMark Width="26" Height="26" Margin="0,1,0,0" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource Brand.DisplayFont}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource Brand.Text}" Margin="0" LineHeight="24">
                    <Run Text="Talk" /><Run Text="2" Foreground="{StaticResource Brand.Coral}" /><Run Text="Me" />
                </TextBlock>
                <TextBlock Text="Hold. Speak. Done." Foreground="{StaticResource Brand.TextMuted}" FontSize="11.5" Margin="1,0,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Push-to-talk key" />
        <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True"
                  ItemsSource="{Binding Hotkeys}"
                  Text="{Binding Draft.Hotkey, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Hold to talk, release to type. Pick a name from the list, or a hex code like 0xA3." />

        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Draft.SuppressHotkey}">
            <TextBlock Text="Hide the key from other apps (not applied to modifier keys)" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Microphone" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  ItemsSource="{Binding InputDevices}"
                  SelectedItem="{Binding SelectedInputDevice}" />

        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Language" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Draft.Language, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Engine" />
        <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding Engines}"
                  SelectedItem="{Binding Draft.Engine}" />
        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Auto uses Parakeet (fast, most accurate for English and 24 other European languages, 670 MB) and falls back to Whisper for everything else." />

        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Whisper model" />
        <ComboBox Grid.Row="8" Grid.Column="1"
                  ItemsSource="{Binding Models}"
                  SelectedItem="{Binding Draft.Model}" />
        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Hint}"
                   Text="Only used when the Whisper engine is active. LargeV3Turbo is the best fit for an RTX 4060 Ti (1.6 GB download)." />

        <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Ignore taps under (ms)" />
        <TextBox Grid.Row="10" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                 Text="{Binding MinimumHoldText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Insert text by" />
        <ComboBox Grid.Row="11" Grid.Column="1"
                  ItemsSource="{Binding InjectionModes}"
                  SelectedItem="{Binding Draft.InjectionMode}" />

        <CheckBox Grid.Row="12" Grid.Column="1" Content="Remove filler words (um, uh, erm…)"
                  IsChecked="{Binding Draft.RemoveFillerWords}" />
        <CheckBox Grid.Row="13" Grid.Column="1" Content="Add a trailing space after each dictation"
                  IsChecked="{Binding Draft.AppendTrailingSpace}" />



        <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding Draft.Overlay.AlwaysVisible}">
            <TextBlock Text="Keep the status pill on screen between dictations" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Grid.Row="15" Style="{StaticResource Label}" Text="Pill position" />
        <StackPanel Grid.Row="15" Grid.Column="1">
            <ComboBox ItemsSource="{Binding OverlayPositions}" SelectedItem="{Binding Draft.Overlay.Position}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="The pill rests dimmed showing your hotkey, and returns to the front the moment you start speaking. It is click-through and never takes focus, so whatever you clicked into keeps the caret." />
        </StackPanel>

        <!-- Collapsed by default: this is the one feature that sends anything off the machine. -->
        <Expander Grid.Row="16" Grid.ColumnSpan="2" Margin="0,6,0,10"
                  Foreground="{StaticResource Brand.Text}"
                  Header="AI cleanup (sends text to Claude)">
            <StackPanel Margin="0,10,0,0">
                <CheckBox IsChecked="{Binding Draft.Cleanup.UseLlm}">
                    <TextBlock Text="Rewrite each dictation with Claude before typing it" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,12"
                           Text="Off by default. When on, the transcript — and nothing else — is sent to the Anthropic API. Speech and audio never leave this machine either way. If the call is slow or fails, the plain cleaned-up text is typed instead." />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Anthropic API key" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,4" MinHeight="28" Padding="6,4"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource InputText}"
                             PasswordChanged="OnApiKeyChanged" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{Binding ApiKeyStatus}" />
                <Button Content="Forget stored key" HorizontalAlignment="Left" Margin="0,0,0,12"
                        Command="{Binding ClearApiKeyCommand}" />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Style" />
                <ComboBox ItemsSource="{Binding CleanupStyles}" SelectedItem="{Binding Draft.Cleanup.Style}" />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Model" />
                <ComboBox IsEditable="True" ItemsSource="{Binding CleanupModels}"
                          Text="{Binding Draft.Cleanup.Model, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="claude-opus-5 rewrites best; claude-haiku-4-5 answers fastest and costs least." />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Give up after (ms)" />
                <TextBox Width="90" HorizontalAlignment="Left"
                         Text="{Binding CleanupTimeoutText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Personal dictionary" />
                <TextBox Text="{Binding VocabularyText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Names, jargon and acronyms the recogniser gets wrong, comma separated, spelled how you want them typed." />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Extra instructions" />
                <TextBox Text="{Binding Draft.Cleanup.CustomInstructions, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                         VerticalContentAlignment="Top" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                           Text="For example: British spelling. Never use em dashes. Keep it under three sentences." />
            </StackPanel>
        </Expander>


        <Expander Grid.Row="17" Grid.ColumnSpan="2" Margin="0,0,0,10"
                  Foreground="{StaticResource Brand.Text}"
                  Header="History (keeps what you dictate on disk)">
            <StackPanel Margin="0,10,0,0">
                <CheckBox IsChecked="{Binding Draft.History.Enabled}">
                    <TextBlock Text="Keep a log of every dictation" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,12"
                           Text="So you can copy back a dictation that went into the wrong window. Everything you dictate is stored in plain text under your profile — switch this off if that is not something you want on disk." />

                <CheckBox IsChecked="{Binding Draft.History.OpenOnStart}"
                          Content="Open the history window when Talk2Me starts" />

                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Keep at most" />
                <TextBox Width="90" HorizontalAlignment="Left"
                         Text="{Binding HistoryMaxEntriesText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding HistoryStatus}" />
                <Button Content="Clear history…" HorizontalAlignment="Left" Margin="0"
                        Command="{Binding ClearHistoryCommand}" />
            </StackPanel>
        </Expander>

        <TextBlock Grid.Row="18" Style="{StaticResource Label}" Text="Downloaded models" VerticalAlignment="Top" Margin="0,4,12,10" />
        <StackPanel Grid.Row="18" Grid.Column="1" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,6" Text="{Binding ModelStorageText}" />

            <ItemsControl ItemsSource="{Binding InstalledModels}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brand.Text}" />
                                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brand.TextMuted}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal">
                <Button Content="Delete selected…" Margin="0"
                        Command="{Binding DeleteSelectedModelsCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="Delete all…"
                        Command="{Binding DeleteAllModelsCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="19" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,8,0,14"
                   Text="{Binding SettingsPath, StringFormat='Saved to {0}'}" />

        <StackPanel Grid.Row="20" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
