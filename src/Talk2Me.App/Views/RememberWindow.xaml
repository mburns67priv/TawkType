<Window x:Class="Talk2Me.Desktop.Views.RememberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remember this correction"
        Icon="pack://application:,,,/Assets/talk2me.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="{StaticResource Brand.Font}"
        FontSize="13">
    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="Remember this correction" FontFamily="{StaticResource Brand.DisplayFont}"
                   FontSize="16" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ui.TextMuted}" FontSize="11.5"
                   Margin="0,0,0,14"
                   Text="Talk2Me will make this change to every dictation from now on, whether or not the Claude pass is switched on." />

        <TextBlock Text="When you hear" Style="{StaticResource Ui.Label}" />
        <TextBox x:Name="HeardBox" Style="{StaticResource Ui.TextBox}" Margin="0,0,0,12" />

        <TextBlock Text="Type this instead" Style="{StaticResource Ui.Label}" />
        <TextBox x:Name="TypedBox" Style="{StaticResource Ui.TextBox}" />

        <TextBlock x:Name="Problem" Style="{StaticResource Ui.FieldError}" Visibility="Collapsed"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Ui.Button}" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancelClick" />
            <Button Content="Remember" Style="{StaticResource Ui.PrimaryButton}" IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
